# In dev, Vite proxies /api/* to this target so the browser doesn't hit CORS.
# Point this at wherever your backend is running.
VITE_API_PROXY_TARGET=http://localhost:3030

# In production builds, /api/* requests are sent to the same origin that serves
# the static files. If your backend lives on a different origin in production,
# set VITE_API_BASE_URL (with NO trailing slash) and the API client will use it.
# Leave commented out to use same-origin /api.
# VITE_API_BASE_URL=https://inventory.example.com
