PORT=3030
DB_PATH=./database/inventory.db
NODE_ENV=development
GOOGLE_API_KEY=

# 首次建庫時建立的 admin（兩個都設定才會建立；已存在則略過）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 出貨單 Webhook：建立出貨單時 POST JSON 到此 URL（留空則不送）
STOCK_WEBHOOK_URL=

# 出貨單 LINE 推播（Messaging API）：兩個都設定才會送
# LINE_TO 為接收者 user ID（U 開頭）或群組 ID（C 開頭）；取得方式見 docs/operations/NOTIFICATIONS.md
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# 每週備份 Email（SMTP）
BACKUP_EMAIL_HOST=smtp.gmail.com
BACKUP_EMAIL_PORT=587
BACKUP_EMAIL_USER=your@gmail.com
BACKUP_EMAIL_PASS=your_app_password
BACKUP_EMAIL_TO=your@gmail.com