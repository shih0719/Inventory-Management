# Inventory Query Skill 環境變數配置
#
# 此 skill 用於查詢產品庫存
#
# 使用方式：
#   1. 複製此檔案為 .env
#   2. 根據你的環境修改伺服器地址
#   3. 執行 query_inventory.js 時會自動讀取
#
# 優先級: 命令列參數 > .env > 系統環境變數 > 預設值
#   例: node query_inventory.js --host 192.168.1.100  # 覆蓋 .env 設定

# API 伺服器地址
# 本地開發: localhost
# 遠端伺服器: 192.168.1.100 或 api.example.com
INVENTORY_API_HOST=localhost

# API 伺服器連接埠（預設 3000）
INVENTORY_API_PORT=3000
